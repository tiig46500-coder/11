rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Community messages
    match /community_messages/{messageId} {
      allow read: if true;
      allow create: if incoming().content is string && incoming().content.size() <= 5000;
      allow update: if true;
      allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || request.auth.uid != null);
    }

    // Global stats
    match /community_stats/{statId} {
      allow read: if true;
      allow create, update: if true;
    }
  }
}
